---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import MatrixRain from '../components/MatrixRain.astro';
import { withBase } from '../utils/withBase';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Jeffrey Rathgeber Jr. — M.S. Cybersecurity student at NYU Tandon and IT Infrastructure Intern at Harvard Management Company. Security & infrastructure portfolio.',
} = Astro.props;

const fullTitle = title === '~' ? 'rathgeberj.dev' : `${title} — rathgeberj.dev`;

// Absolute URLs for the canonical link and social-share cards.
// Astro.site = https://rathgeberj.dev (from astro.config.mjs).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Branded terminal "&gt;_" card — never the headshot (that stays on the homepage only).
const ogImageURL = new URL(withBase('/images/og-card.png'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- Open Graph (LinkedIn, Facebook, Slack, iMessage, Discord, WhatsApp, ...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="rathgeberj.dev" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <MatrixRain />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-2 focus:left-2 focus:px-3 focus:py-1 focus:bg-terminal-surface focus:text-terminal-accent focus:border focus:border-terminal-accent"
    >
      skip to content
    </a>
    <Nav />
    <main id="main" class="max-w-6xl mx-auto px-4 sm:px-6 py-8 animate-fade-in">
      <slot />
    </main>
  </body>
</html>
