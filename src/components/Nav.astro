---
// Persistent top nav styled as a terminal title bar.
// Active route is highlighted green; current path shown as a terminal breadcrumb.
// Mobile: hamburger button opens a full-screen overlay (vanilla JS, no libraries).

const links = [
  { label: '~', href: '/' },
  { label: 'exp', href: '/experience' },
  { label: 'edu', href: '/education' },
  { label: 'projects', href: '/projects' },
  { label: 'certs', href: '/certifications' },
  { label: 'skills', href: '/competencies' },
  { label: 'orgs', href: '/organizations' },
  { label: 'interests', href: '/interests' },
  { label: 'contact', href: '/contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

// Terminal-style breadcrumb: "/" → "~", "/projects/homelab" → "~/projects/homelab"
const breadcrumb = currentPath === '/' ? '~' : `~${currentPath}`;
---

<header class="sticky top-0 z-40 bg-terminal-bg/95 backdrop-blur-sm border-b border-terminal-border">
  <nav aria-label="Main navigation" class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-12 text-sm">
      <a href="/" class="text-terminal-green whitespace-nowrap hover:text-terminal-text">
        jeff@rathgeberj:~$<span class="cursor-blink" aria-hidden="true"></span>
      </a>

      <!-- Desktop links -->
      <ul class="hidden md:flex items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'px-2 py-1 rounded-sm',
                  isActive(link.href)
                    ? 'text-terminal-green border border-terminal-green/40 shadow-glow-green-sm'
                    : 'text-terminal-muted hover:text-terminal-text',
                ]}
              >
                [{link.label}]
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Mobile hamburger -->
      <button
        id="nav-toggle"
        type="button"
        class="md:hidden px-2 py-1 text-terminal-green border border-terminal-border rounded-sm"
        aria-expanded="false"
        aria-controls="nav-overlay"
        aria-label="Open navigation menu"
      >
        ≡
      </button>
    </div>

    <!-- Breadcrumb: current route as terminal path -->
    <div class="pb-1.5 text-xs text-terminal-muted" aria-label="Breadcrumb">
      <span class="text-terminal-green">&gt;</span> pwd: {breadcrumb}
    </div>
  </nav>

  <!-- Mobile full-screen overlay -->
  <div
    id="nav-overlay"
    class="hidden md:hidden fixed inset-0 z-50 bg-terminal-bg/98 backdrop-blur-sm"
  >
    <div class="flex items-center justify-between h-12 px-4 border-b border-terminal-border text-sm">
      <span class="text-terminal-green">jeff@rathgeberj:~$</span>
      <button
        id="nav-close"
        type="button"
        class="px-2 py-1 text-terminal-red border border-terminal-border rounded-sm"
        aria-label="Close navigation menu"
      >
        ✕
      </button>
    </div>
    <ul class="flex flex-col gap-2 p-6 text-lg">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'block px-3 py-2 rounded-sm border',
                isActive(link.href)
                  ? 'text-terminal-green border-terminal-green/40 shadow-glow-green-sm'
                  : 'text-terminal-text border-transparent hover:border-terminal-border',
              ]}
            >
              <span class="text-terminal-muted">&gt;</span> [{link.label}]
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const close = document.getElementById('nav-close');
  const overlay = document.getElementById('nav-overlay');

  function setOpen(open: boolean) {
    overlay?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
