---
// Left-column profile panel for the landing dashboard.
// Typewriter subtitle cycles through the phrases below (vanilla JS, no libraries).
// Visitors with prefers-reduced-motion see the first phrase statically.

// [PLACEHOLDER] Taglines — to be updated
const taglines = ['Cybersecurity Engineer', 'Graduate Researcher', 'Systems Thinker'];

const quickLinks = [
  {
    label: 'GitHub',
    url: 'https://github.com/Rathgeberj',
    icon: 'M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z',
  },
  {
    label: 'LinkedIn',
    url: 'https://linkedin.com/in/rathgeberjr',
    icon: 'M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5ZM.5 8h4V24h-4V8Zm7.5 0h3.83v2.18h.05c.53-1 1.84-2.18 3.79-2.18 4.05 0 4.8 2.67 4.8 6.14V24h-4v-8.5c0-2.03-.04-4.64-2.83-4.64-2.83 0-3.26 2.21-3.26 4.5V24H8V8Z',
  },
  {
    label: 'Email',
    url: 'mailto:jeff@rathgeberj.dev', // [PLACEHOLDER] — replace with real preferred email
    icon: 'M1.5 4.5h21a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-21a1 1 0 0 1-1-1v-13a1 1 0 0 1 1-1Zm1.7 2 8.8 6.6 8.8-6.6H3.2Zm18.3 1.9-8.9 6.67a1 1 0 0 1-1.2 0L2.5 8.4v9.1h19V8.4Z',
  },
];
---

<aside class="panel p-6 flex flex-col items-center text-center" aria-label="Profile">
  <!-- [PLACEHOLDER] profile photo — replace public/images/profile-placeholder.svg -->
  <img
    src="/images/profile-placeholder.svg"
    alt="Profile photo of Jeffrey Rathgeber Jr. (placeholder)"
    width="144"
    height="144"
    class="w-36 h-36 rounded-full ring-2 ring-terminal-green/70 shadow-glow-green-sm"
  />

  <h1 class="mt-5 text-xl font-bold text-terminal-text">
    Jeffrey Rathgeber Jr.
  </h1>

  <p class="mt-1 h-6 text-terminal-green text-sm" aria-label={taglines.join(', ')}>
    <span id="typewriter" data-phrases={JSON.stringify(taglines)} aria-hidden="true"
      >{taglines[0]}</span
    ><span class="cursor-blink" aria-hidden="true"></span>
  </p>

  <!-- [PLACEHOLDER] Bio — 2-3 sentences, to be updated -->
  <p class="mt-4 text-sm text-terminal-muted leading-relaxed">
    Computer science graduate and cybersecurity master's student with hands-on IT and
    security experience. Focused on infrastructure, automation, and applied security
    research. [PLACEHOLDER]
  </p>

  <ul class="mt-5 flex gap-4" aria-label="Quick links">
    {
      quickLinks.map((link) => (
        <li>
          <a
            href={link.url}
            target={link.url.startsWith('http') ? '_blank' : undefined}
            rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            aria-label={link.label}
            title={link.label}
            class="block p-2 border border-terminal-border rounded-sm text-terminal-muted hover:text-terminal-green hover:border-terminal-green hover:shadow-glow-green-sm transition-all duration-150"
          >
            <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current" aria-hidden="true">
              <path d={link.icon} />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<script>
  const el = document.getElementById('typewriter');
  const phrases: string[] = JSON.parse(el?.dataset.phrases ?? '[]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && phrases.length > 1 && !reduceMotion) {
    const TYPE_MS = 70;
    const DELETE_MS = 35;
    const HOLD_MS = 2200;
    let phrase = 0;

    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    (async () => {
      while (true) {
        const text = phrases[phrase];
        for (let i = el.textContent!.length; i > 0; i--) {
          el.textContent = el.textContent!.slice(0, -1);
          await sleep(DELETE_MS);
        }
        for (let i = 1; i <= text.length; i++) {
          el.textContent = text.slice(0, i);
          await sleep(TYPE_MS);
        }
        await sleep(HOLD_MS);
        phrase = (phrase + 1) % phrases.length;
      }
    })();
  }
</script>
