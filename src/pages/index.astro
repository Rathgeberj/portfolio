---
// [PLACEHOLDER] Temporary stub to verify the foundation builds.
// Will be replaced by the Landing Dashboard (profile panel + module grid)
// in the page-by-page build phase.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="~">
  <section class="panel relative scanlines p-6 sm:p-10">
    <h2 class="section-label mb-4">SYSTEM</h2>
    <h1 class="text-2xl sm:text-4xl font-bold">
      Jeffrey Rathgeber Jr.<span class="cursor-blink" aria-hidden="true"></span>
    </h1>
    <p class="mt-4 text-terminal-muted">
      <span class="text-terminal-green">&gt;</span> Foundation scaffolded. Landing dashboard coming next.
      <span class="status-dot-green ml-2" aria-hidden="true"></span>
      <span class="text-xs uppercase tracking-widest ml-1">online</span>
    </p>
  </section>
</BaseLayout>
